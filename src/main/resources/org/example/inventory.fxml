<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.InventoryController" spacing="24" styleClass="page-content">
    <padding><Insets top="30" right="34" bottom="34" left="34"/></padding>
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="7" HBox.hgrow="ALWAYS">
            <Label text="Inventario" styleClass="page-title"/>
            <Label text="Administra tus productos y mantén el control de tu stock." styleClass="page-subtitle"/>
        </VBox>
        <Button text="＋  Añadir producto" onAction="#addProduct" styleClass="button-primary"/>
    </HBox>
    <HBox spacing="14" styleClass="metric-row">
        <VBox spacing="8" styleClass="metric-card"><Label text="PRODUCTOS ACTIVOS" styleClass="metric-caption"/><Label text="248" styleClass="metric-value"/><Label text="↑  12 este mes" styleClass="metric-positive"/></VBox>
        <VBox spacing="8" styleClass="metric-card"><Label text="VALOR DEL INVENTARIO" styleClass="metric-caption"/><Label text="24,680 USD" styleClass="metric-value"/><Label text="Actualizado hace unos segundos" styleClass="metric-note"/></VBox>
        <VBox spacing="8" styleClass="metric-card"><Label text="STOCK BAJO" styleClass="metric-caption"/><Label text="08" styleClass="metric-value metric-warning"/><Label text="Requieren atención" styleClass="metric-note"/></VBox>
    </HBox>
    <VBox spacing="14" VBox.vgrow="ALWAYS" styleClass="table-card">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Todos los productos" styleClass="card-title"/><Label text="Una vista general de tu catálogo." styleClass="card-subtitle"/></VBox>
            <Button text="☷  Filtrar" onAction="#filterProducts" styleClass="button-secondary"/>
            <Button text="↥  Exportar" onAction="#exportProducts" styleClass="button-secondary"/>
        </HBox>
        <TableView fx:id="productTable" VBox.vgrow="ALWAYS" styleClass="product-table">
            <columns>
                <TableColumn fx:id="productColumn" text="PRODUCTO" prefWidth="390"/>
                <TableColumn fx:id="stockColumn" text="STOCK" prefWidth="130"/>
                <TableColumn fx:id="categoryColumn" text="CATEGORÍA" prefWidth="210"/>
                <TableColumn fx:id="priceColumn" text="PRECIO" prefWidth="150"/>
            </columns>
        </TableView>
        <Label text="Mostrando productos de ejemplo · Los cambios no se guardan" styleClass="table-footnote"/>
    </VBox>
</VBox>
